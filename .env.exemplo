# ==========================================================================
# IZATEC TECIDOS — variáveis de ambiente
#
#   cp .env.exemplo .env && chmod 600 .env
#
# O `.env` NUNCA vai para o repositório (está no .gitignore). No servidor ele é
# lido pelo systemd (`EnvironmentFile=` na unit) e pelo criar-site.sh.
# ==========================================================================

# --------------------------------------------------------------- ENDEREÇO
# Manda no canonical, no JSON-LD, no sitemap e no robots.txt.
#
# Qualquer endereço em `.projetos.luizaugust.me` é tratado como ENDEREÇO DE
# TRABALHO e sai automaticamente FORA do índice do Google (robots.txt fechado
# + X-Robots-Tag: noindex em toda resposta). Não há caixinha para marcar.
#
# No dia da virada, troque esta linha e reinicie:
#   IZATEC_SITE=https://izatectecidos.com.br
IZATEC_SITE=https://izatec.projetos.luizaugust.me

# Força a indexação nos dois sentidos, se algum dia for preciso: sim | nao
# Em branco = decide pelo domínio, que é o certo em 99% dos casos.
#IZATEC_INDEXAVEL=

# ---------------------------------------------------------------- SEGREDO
# Assina o cookie do carrinho. Gere com:  openssl rand -hex 32
#
# TROCAR ESTA CHAVE ESVAZIA O CARRINHO DE QUEM ESTAVA COMPRANDO. Não é perda de
# dado — o pedido gravado continua lá —, mas quem estava montando o pedido volta
# e encontra a tela vazia sem entender por quê.
#
# Em branco, o sistema sorteia uma e guarda no banco. Funciona, mas aí a chave
# viaja junto com o arquivo do banco (inclusive nos backups).
IZATEC_SEGREDO=

# ------------------------------------------------------------------ REDE
PORT=5198
HOST=127.0.0.1

# --------------------------------------------------------------- BACKUPS
# Quantas cópias diárias guardar antes de apagar as mais velhas.
IZATEC_BACKUPS_MANTER=14
