[Unit]
Description=Backup do banco da Izatec
After=izatec.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/www/projetos/Izatec-Tecidos
Environment=IZATEC_BACKUPS_MANTER=14
ExecStart=/usr/bin/node ferramentas/backup.cjs

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/projetos/Izatec-Tecidos/data
ReadWritePaths=/var/www/projetos/Izatec-Tecidos/backups

SyslogIdentifier=izatec-backup
